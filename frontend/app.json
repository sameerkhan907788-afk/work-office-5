{
  "expo": {
    "name": "Jarvis Office",
    "slug": "jarvis-office",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jarvis-icon.png",
    "scheme": "jarvisoffice",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jarvisai.office"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/jarvis-icon.png",
        "backgroundColor": "#FFF7F0"
      },
      "package": "com.jarvisai.office"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/jarvis-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
